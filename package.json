{
  "name": "axiom-proof",
  "version": "0.1.0",
  "private": true,
  "description": "Axiom Proof — agentic DPDPA compliance platform · Axiom Minds Private Limited",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "gate:security": "./scripts/check-env-security-gate.sh",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,md,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,md,json,yaml,yml}\"",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "prepare": "husky || true",
    "seed:controls": "tsx packages/control-library/scripts/seed.ts",
    "seed:users": "tsx scripts/seed-users.ts",
    "infra:plan": "cd infra/terraform/envs/prod && terraform plan",
    "infra:apply": "cd infra/terraform/envs/prod && terraform apply",
    "db:migrate": "if [ -n \"$SUPABASE_DB_URL\" ]; then supabase db push --db-url \"$SUPABASE_DB_URL\" --workdir infra; else supabase db push --local --workdir infra; fi",
    "db:reset": "supabase db reset --workdir infra",
    "agents:test": "cd services/agent-runtime && uv run pytest",
    "docker:deploy": "./scripts/dev-docker.sh",
    "docker:up": "./scripts/dev-docker.sh",
    "docker:down": "./scripts/dev-docker.sh --down",
    "docker:status": "./scripts/dev-docker.sh --status",
    "docker:build": "./scripts/dev-docker.sh --build",
    "docker:test": "./scripts/dev-docker.sh --test",
    "pre-ci": "./scripts/dev-docker.sh --test",
    "staging:deploy": "./scripts/deploy-staging.sh",
    "staging:flow": "./scripts/run-staging-flow.sh",
    "staging:setup:win": "powershell.exe -ExecutionPolicy Bypass -File ./scripts/setup-windows-staging.ps1",
    "staging:deploy:win": "powershell.exe -ExecutionPolicy Bypass -File ./scripts/deploy-staging.ps1",
    "staging:flow:win": "powershell.exe -ExecutionPolicy Bypass -File ./scripts/run-staging-flow.ps1",
    "preprod:build": "./scripts/build-preprod-images.sh",
    "preprod:deploy": "./scripts/deploy-preprod-gcp.sh",
    "preprod:flow": "./scripts/run-preprod-flow.sh",
    "preprod:migrate": "./scripts/migrate-cloudsql.sh",
    "marketing:deploy:firebase": "./scripts/deploy-firebase-marketing.sh",
    "env:verify": "./scripts/sync-env.sh preprod verify",
    "env:verify:all": "./scripts/sync-env.sh preprod verify && ./scripts/sync-env.sh staging verify && ./scripts/sync-env.sh local verify && ./scripts/sync-env.sh production verify",
    "env:tf": "./scripts/sync-env.sh preprod terraform",
    "env:secrets": "./scripts/sync-env.sh preprod secrets",
    "env:sync": "./scripts/sync-env.sh preprod all",
    "gate:controls": "./scripts/check-control-count.sh",
    "gate:controls:drift": "./scripts/check-controls-drift.sh",
    "build:controls-json": "tsx scripts/build-controls-json.mjs",
    "security:scan": "bash scripts/security-scan.sh"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@types/node": "^26.5.1",
    "husky": "^9.1.6",
    "jose": "6.2.12",
    "prettier": "^3.3.3",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "zod": "4.5.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.18",
      "sharp": "^0.35.0"
    }
  }
}
