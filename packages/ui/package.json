{
  "name": "@axiom/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./primitives/*": "./src/primitives/*.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no lint config'",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo coverage",
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json && tailwindcss -c tailwind.config.ts -i src/styles.css -o dist/ui.css --minify"
  },
  "dependencies": {
    "@axiom/design-tokens": "workspace:*",
    "@radix-ui/react-slot": "^1.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
