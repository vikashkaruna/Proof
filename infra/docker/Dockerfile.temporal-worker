# Axiom Proof — Temporal worker Dockerfile

FROM python:3.11-slim AS base
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates && rm -rf /var/lib/apt/lists/*

RUN pip install uv

COPY services/temporal-workers/pyproject.toml ./services/temporal-workers/
COPY services/temporal-workers/src ./services/temporal-workers/src
COPY packages/offline-license-python ./packages/offline-license-python
WORKDIR /app/services/temporal-workers
RUN uv pip install --system -e .

ENV PYTHONPATH="/app/services/temporal-workers/src:/app/packages/offline-license-python"
WORKDIR /app/services/temporal-workers

RUN useradd --create-home --shell /bin/bash axiom
USER axiom

CMD ["python", "-m", "temporal_workers.worker"]
