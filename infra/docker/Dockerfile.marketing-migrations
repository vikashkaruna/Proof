# Build with an explicitly reviewed immutable Python Alpine base digest and
# an exact PostgreSQL client package version from the release environment.
ARG POSTGRES_CLIENT_IMAGE
FROM ${POSTGRES_CLIENT_IMAGE}
ARG AXIOM_RELEASE_SHA
ARG POSTGRES_CLIENT_APK_PACKAGE
RUN test "${#AXIOM_RELEASE_SHA}" -eq 40 && case "$AXIOM_RELEASE_SHA" in *[!0-9a-f]*) exit 1;; esac
LABEL org.opencontainers.image.revision=${AXIOM_RELEASE_SHA}
RUN printf '%s\n' "$POSTGRES_CLIENT_APK_PACKAGE" | grep -Eq '^postgresql17-client=[0-9]+\.[0-9]+-r[0-9]+$' \
    && test -s /etc/ssl/certs/ca-certificates.crt \
    && apk add --no-cache "$POSTGRES_CLIENT_APK_PACKAGE" \
    && rm -rf /usr/local/lib/python3.*/site-packages/pip* /usr/local/lib/python3.*/site-packages/setuptools* /usr/local/lib/python3.*/site-packages/wheel* \
    && rm -f /usr/local/bin/pip* \
    && ! python -m pip --version 2>/dev/null
WORKDIR /app
COPY scripts/migrate-database.py scripts/marketing-db-job.py /app/scripts/
COPY scripts/marketing-state-adoption.py scripts/marketing-acceptance-job.py scripts/marketing-acceptance-readback.py scripts/marketing-acceptance-config.py /app/scripts/
COPY scripts/lib/ops-env-parse.py /app/scripts/lib/ops-env-parse.py
COPY infra/supabase/bootstrap-selfhosted.sql /app/infra/supabase/bootstrap-selfhosted.sql
COPY --chown=65532:65532 infra/supabase/marketing-library.json /app/infra/supabase/marketing-library.json
COPY infra/supabase/migrations /app/infra/supabase/migrations/
ENV AXIOM_RELEASE_SHA=${AXIOM_RELEASE_SHA} PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 65532:65532
ENTRYPOINT ["python3", "/app/scripts/marketing-db-job.py"]
