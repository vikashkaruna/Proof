# Axiom Proof — Marketing site Dockerfile (standalone output)

FROM node:24-alpine AS base
WORKDIR /app
RUN apk add --no-cache libc6-compat
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/marketing/package.json ./apps/marketing/
COPY packages/config/package.json ./packages/config/
COPY packages/mfa/package.json ./packages/mfa/
COPY packages/eslint-config/package.json ./packages/eslint-config/
COPY packages/control-library/package.json ./packages/control-library/
COPY packages/supabase/package.json ./packages/supabase/
COPY packages/types/package.json ./packages/types/
COPY packages/ui/package.json ./packages/ui/
COPY packages/design-tokens/package.json ./packages/design-tokens/
RUN --mount=type=cache,id=axiom-pnpm,target=/pnpm/store pnpm install --store-dir=/pnpm/store --frozen-lockfile --filter @axiom/marketing...

FROM base AS build
ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_BFF_URL
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_BFF_URL=$NEXT_PUBLIC_BFF_URL
ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY
COPY --from=deps /app /app
COPY tsconfig.base.json ./
COPY apps/marketing ./apps/marketing
COPY packages ./packages
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm --filter @axiom/marketing build

FROM base AS runtime
ARG AXIOM_RELEASE_SHA
ENV AXIOM_RELEASE_SHA=$AXIOM_RELEASE_SHA
LABEL org.opencontainers.image.revision=$AXIOM_RELEASE_SHA
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
RUN apk add --no-cache tini
COPY --chown=node:node --from=build /app/apps/marketing/.next/standalone ./
COPY --chown=node:node --from=build /app/apps/marketing/.next/static ./apps/marketing/.next/static
COPY --chown=node:node --from=build /app/apps/marketing/public ./apps/marketing/public
RUN chown -R node:node /app
EXPOSE 3000
USER node
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "apps/marketing/server.js"]
