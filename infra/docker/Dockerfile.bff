# Axiom Proof — BFF Dockerfile
# Multi-stage build: compile TS, then run slim Node image.

FROM node:24-alpine AS base
WORKDIR /app
RUN apk add --no-cache libc6-compat
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate

# ─── deps ──────────────────────────────────────────────────────────
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY services/bff/package.json ./services/bff/
COPY packages/approval-engine/package.json ./packages/approval-engine/
COPY packages/config/package.json ./packages/config/
COPY packages/mfa/package.json ./packages/mfa/
COPY packages/eslint-config/package.json ./packages/eslint-config/
COPY packages/control-library/package.json ./packages/control-library/
COPY packages/evidence/package.json ./packages/evidence/
COPY packages/ledger/package.json ./packages/ledger/
COPY packages/supabase/package.json ./packages/supabase/
COPY packages/types/package.json ./packages/types/
COPY packages/ui/package.json ./packages/ui/
COPY packages/design-tokens/package.json ./packages/design-tokens/
RUN --mount=type=cache,id=axiom-pnpm,target=/pnpm/store pnpm install --store-dir=/pnpm/store --frozen-lockfile --filter @axiom/bff...

# ─── build ─────────────────────────────────────────────────────────
FROM base AS build
COPY --from=deps /app /app
COPY tsconfig.base.json ./
COPY services/bff ./services/bff
COPY packages ./packages
RUN pnpm --filter @axiom/bff build

# ─── runtime ───────────────────────────────────────────────────────
FROM base AS runtime
ARG AXIOM_RELEASE_SHA
ENV AXIOM_RELEASE_SHA=$AXIOM_RELEASE_SHA
LABEL org.opencontainers.image.revision=$AXIOM_RELEASE_SHA
WORKDIR /app
RUN apk add --no-cache tini
ENV NODE_ENV=production
ENV PORT=4000
COPY --from=build /app /app
WORKDIR /app/services/bff
EXPOSE 4000
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["pnpm", "exec", "tsx", "src/index.ts"]
