# Axiom Proof — BFF Dockerfile
# Multi-stage build: compile TS, then run slim Node image.

ARG NODE_RUNTIME_IMAGE=node:24-alpine
FROM ${NODE_RUNTIME_IMAGE} AS base
WORKDIR /app
RUN apk add --no-cache libc6-compat
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate

# ─── deps ──────────────────────────────────────────────────────────
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY services/bff/package.json ./services/bff/
COPY packages/approval-engine/package.json ./packages/approval-engine/
COPY packages/config/package.json ./packages/config/
COPY packages/mfa/package.json ./packages/mfa/
COPY packages/eslint-config/package.json ./packages/eslint-config/
COPY packages/control-library/package.json ./packages/control-library/
COPY packages/evidence/package.json ./packages/evidence/
COPY packages/report-kit/package.json ./packages/report-kit/
COPY packages/ledger/package.json ./packages/ledger/
COPY packages/supabase/package.json ./packages/supabase/
COPY packages/types/package.json ./packages/types/
COPY packages/ui/package.json ./packages/ui/
COPY packages/design-tokens/package.json ./packages/design-tokens/
RUN --mount=type=cache,id=axiom-pnpm,target=/pnpm/store pnpm install --store-dir=/pnpm/store --frozen-lockfile --filter @axiom/bff...

# ─── build ─────────────────────────────────────────────────────────
FROM base AS build
COPY --from=deps /app /app
COPY tsconfig.base.json ./
COPY services/bff ./services/bff
COPY packages ./packages
RUN pnpm --filter @axiom/bff build

# Explicit dedicated runner image. Deployment supplies only this trusted
# controller with the daemon group/socket; workers never inherit either.
FROM build AS assessment-controller
RUN apk add --no-cache docker-cli tini
ENV NODE_ENV=production TSX_DISABLE_CACHE=1
USER 20000:20000
WORKDIR /app/services/bff
ENTRYPOINT ["/sbin/tini", "--", "node", "--import", "/app/node_modules/tsx/dist/loader.mjs", "src/assessment-controller-service.ts"]
CMD []

FROM assessment-controller AS vm-controller-acceptance
COPY scripts/verify-vm-controller.ts /app/scripts/verify-vm-controller.ts
COPY scripts/verify-issuer-sync.ts /app/scripts/verify-issuer-sync.ts

# Test-only controller: no source/token mounts or backend credentials at runtime.
# The normal final runtime target does not contain this acceptance script.
FROM build AS workload-trust-acceptance
COPY scripts/verify-workload-trust.ts /app/scripts/verify-workload-trust.ts

# ─── runtime ───────────────────────────────────────────────────────
FROM ${NODE_RUNTIME_IMAGE} AS common-runtime
WORKDIR /app
RUN apk add --no-cache libc6-compat tini chromium font-noto \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /opt/yarn-* \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg /usr/local/bin/pnpm /usr/local/bin/pnpx
ENV NODE_ENV=production
ENV PORT=4000
COPY --from=build /app /app
# The native TypeScript compiler is needed only by the build, not TSX execution.
RUN rm -rf /app/node_modules/.pnpm/@typescript+typescript-linux-*
WORKDIR /app/services/bff
EXPOSE 4000
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "/app/services/bff/node_modules/tsx/dist/cli.mjs", "src/index.ts"]

# Public marketing acceptance profile: isolated Node runtime without the
# image's global package managers.
FROM ${NODE_RUNTIME_IMAGE} AS marketing-runtime
WORKDIR /app
RUN apk add --no-cache tini=0.19.0-r3 \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /opt/yarn-v1.22.22 \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg
ENV NODE_ENV=production TSX_DISABLE_CACHE=1 PORT=4000
COPY --from=build /app /app
# These lockfile entries are build-only dependencies of the linter/compiler,
# not imports in the marketing service's runtime graph.
RUN rm -rf /app/node_modules/.pnpm/@typescript+typescript-linux-* /app/node_modules/.pnpm/braces@*
WORKDIR /app/services/bff
EXPOSE 4000
USER node
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "/app/services/bff/node_modules/tsx/dist/cli.mjs", "src/marketing-index.ts"]
ARG AXIOM_RELEASE_SHA
ENV AXIOM_RELEASE_SHA=$AXIOM_RELEASE_SHA
LABEL org.opencontainers.image.revision=$AXIOM_RELEASE_SHA

# Keep the default image target as the complete product BFF.
FROM common-runtime AS runtime
ARG AXIOM_RELEASE_SHA
ENV AXIOM_RELEASE_SHA=$AXIOM_RELEASE_SHA
LABEL org.opencontainers.image.revision=$AXIOM_RELEASE_SHA
