# Axiom Proof — Agent Runtime Dockerfile

FROM python:3.14-slim AS base
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install uv (fast Python package manager)
RUN pip install uv

# Python deps first (better layer caching)
COPY services/agent-runtime/pyproject.toml services/agent-runtime/uv.lock ./services/agent-runtime/
COPY services/agent-runtime/src ./services/agent-runtime/src
COPY packages/offline-license-python ./packages/offline-license-python
COPY packages/model-accounting-python ./packages/model-accounting-python
WORKDIR /app/services/agent-runtime
RUN uv sync --locked --no-dev --no-editable

ENV PATH="/app/services/agent-runtime/.venv/bin:$PATH" \
    PYTHONPATH="/app/services/agent-runtime/src:/app/packages/offline-license-python:/app/packages/model-accounting-python"
WORKDIR /app/services/agent-runtime
EXPOSE 8000

# Non-root
RUN useradd --create-home --shell /bin/bash axiom
USER axiom

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://localhost:8000/health || exit 1

ARG AXIOM_RELEASE_SHA
ENV AXIOM_RELEASE_SHA=$AXIOM_RELEASE_SHA
LABEL org.opencontainers.image.revision=$AXIOM_RELEASE_SHA

CMD ["python", "-m", "axiom"]
