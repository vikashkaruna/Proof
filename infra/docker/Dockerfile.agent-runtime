# Axiom Proof — Agent Runtime Dockerfile

FROM python:3.11-slim AS base
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install uv (fast Python package manager)
RUN pip install uv

# Python deps first (better layer caching)
COPY services/agent-runtime/pyproject.toml services/agent-runtime/README.md ./services/agent-runtime/
COPY services/agent-runtime/src ./services/agent-runtime/src
COPY packages/offline-license-python ./packages/offline-license-python
WORKDIR /app/services/agent-runtime
RUN uv pip install --system -e .

ENV PYTHONPATH="/app/services/agent-runtime/src:/app/packages/offline-license-python"
WORKDIR /app/services/agent-runtime
EXPOSE 8000

# Non-root
RUN useradd --create-home --shell /bin/bash axiom
USER axiom

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://localhost:8000/health || exit 1

CMD ["python", "-m", "axiom"]
