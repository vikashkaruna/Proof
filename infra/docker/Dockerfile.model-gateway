# Axiom Proof — Model Gateway Dockerfile

FROM python:3.11-slim AS base
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates && rm -rf /var/lib/apt/lists/*

RUN pip install uv

COPY services/model-gateway/pyproject.toml ./services/model-gateway/
COPY services/model-gateway/src ./services/model-gateway/src
COPY packages/offline-license-python ./packages/offline-license-python
WORKDIR /app/services/model-gateway
RUN uv pip install --system -e .

WORKDIR /app
ENV PYTHONPATH="/app/services/model-gateway/src:/app/packages/offline-license-python"
EXPOSE 8001

RUN useradd --create-home --shell /bin/bash axiom
USER axiom

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -fsS http://localhost:8001/health || exit 1

CMD ["python", "-m", "model_gateway"]
