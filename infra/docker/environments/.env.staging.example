# ==============================================================================
# Axiom Proof — Staging Environment Configuration (.env.staging)
# ==============================================================================
# For local network / LAN deployment (e.g. Windows 11 Home running Docker Desktop)
# and remote staging servers.
#
# Replace HOST_IP with your machine's LAN IP address (e.g. 192.168.1.11)
# ==============================================================================

ENVIRONMENT=staging
NODE_ENV=staging
LOG_LEVEL=info

# LAN Host IP or Domain accessible from devices on the local network
HOST_IP=192.168.1.11

# Docker Image Tag & Optional Docker Hub Registry Prefix
# Leave DOCKER_REGISTRY empty for locally built images, or set to your Docker Hub username
# e.g.: DOCKER_REGISTRY=vikashkaruna
DOCKER_REGISTRY=
IMAGE_TAG=staging

# Service Exposed Ports
MARKETING_PORT=3000
WEB_PORT=3001
BFF_PORT=4000
AGENT_RUNTIME_PORT=8000
MODEL_GATEWAY_PORT=8001
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
SUPABASE_API_PORT=55321
SUPABASE_DB_PORT=55322
SUPABASE_STUDIO_PORT=55323

# Supabase Staging Settings
# When running on host or via compose, host.docker.internal resolves to the host machine.
SUPABASE_URL=http://host.docker.internal:55321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
SUPABASE_DB_URL=postgresql://postgres:postgres@host.docker.internal:55322/postgres

# Next.js Client-Side URLs (Browser-facing: Must use reachable IP / Hostname)
NEXT_PUBLIC_SUPABASE_URL=http://192.168.1.11:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
NEXT_PUBLIC_BFF_URL=http://192.168.1.11:4000
NEXT_PUBLIC_APP_URL=http://192.168.1.11:3001
NEXT_PUBLIC_MARKETING_URL=http://192.168.1.11:3000

# Inter-Service Internal Network URLs (Docker Compose bridge network DNS names)
AGENT_RUNTIME_URL=http://agent-runtime:8000
MODEL_GATEWAY_URL=http://model-gateway:8001
BFF_URL=http://bff:4000
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=axiom-proof
TEMPORAL_TLS=false
TEMPORAL_API_KEY=

# Security & Secrets
APPROVAL_SIGNING_KEY=dev-signing-secret-key-at-least-32-chars-long-12345
AGENT_RUNTIME_INTERNAL_TOKEN=dev-agent-runtime-token-axiom
MODEL_GATEWAY_API_KEY=dev-model-gateway-key-axiom
BFF_CORS_ORIGINS=http://192.168.1.11:3000,http://192.168.1.11:3001,http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Sovereign Data Residency & Evidence Vault Storage
AXIOM_REGION=ap-south-1
AXIOM_EVIDENCE_BUCKET=axiom-proof-evidence-staging
AXIOM_STORAGE_ENDPOINT=
AXIOM_STORAGE_ACCESS_KEY_ID=test
AXIOM_STORAGE_SECRET_ACCESS_KEY=test
AWS_REGION=ap-south-1

# Redis Cache
UPSTASH_REDIS_URL=
REDIS_URL=

# Multi-Model LLM Gateway Fallback Hierarchy
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Transactional Email Delivery (Resend)
RESEND_API_KEY=
AXIOM_FROM_EMAIL=Axiom Proof <platform@axiomproof.ai>
RESEND_FROM_EMAIL=Axiom Proof <platform@axiomproof.ai>
AXIOM_SALES_EMAIL=sales@axiomproof.ai
AXIOM_FOUNDER_EMAIL=founder@axiomminds.ai
CONTACT_RECIPIENT_EMAIL=hello@axiomminds.ai
CONTACT_FALLBACK_RECIPIENT_EMAIL=hello@axiomminds.ai

# Feature Flags
FEATURE_DRY_RUN_ENGINE=true
FEATURE_EXECUTION_ENGINE=true
FEATURE_LIVE_CONNECTORS=true
FEATURE_KILL_SWITCH=true
PII_REDACTION_ENABLED=true
AXIOM_E2E_BYPASS_AUTH=false

