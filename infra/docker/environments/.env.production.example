# Axiom Proof — Production Environment (.env.production)
ENVIRONMENT=production
NODE_ENV=production
LOG_LEVEL=warn

# Service Ports
MARKETING_PORT=3000
WEB_PORT=3001
BFF_PORT=4000
AGENT_RUNTIME_PORT=8000
MODEL_GATEWAY_PORT=8001
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233

# Supabase Production (ap-south-1)
# Self-hosted Supabase (W0.1). GoTrue and PostgREST run on Cloud Run against
# this environment's own Cloud SQL, so we own the signing secret rather than a
# managed provider. Mint all three together — the anon and service keys are
# JWTs signed with the secret, and values from separate mintings will not
# validate against each other:
#
#   node scripts/mint-supabase-keys.mjs --env production
#
SUPABASE_JWT_SECRET=<HS256 secret — mint-supabase-keys.mjs>
SUPABASE_URL=https://db.axiomproof.ai
SUPABASE_ANON_KEY=production-anon-key-placeholder
SUPABASE_SERVICE_KEY=production-service-key-placeholder
SUPABASE_DB_URL=postgresql://postgres:production_password@prod-db.internal:5432/postgres

# Next.js Public
NEXT_PUBLIC_SUPABASE_URL=https://db.axiomproof.ai
NEXT_PUBLIC_SUPABASE_ANON_KEY=production-anon-key-placeholder
NEXT_PUBLIC_BFF_URL=https://api.axiomproof.ai
NEXT_PUBLIC_APP_URL=https://app.axiomproof.ai
NEXT_PUBLIC_MARKETING_URL=https://axiomproof.ai

# Inter-service URLs
AGENT_RUNTIME_URL=http://agent-runtime.axiom-proof.svc.cluster.local:8000
MODEL_GATEWAY_URL=http://model-gateway.axiom-proof.svc.cluster.local:8001
BFF_URL=http://bff.axiom-proof.svc.cluster.local:4000
TEMPORAL_ADDRESS=ap-south-1.aws.api.temporal.io:7233
TEMPORAL_NAMESPACE=axiom-proof
TEMPORAL_TLS=true
TEMPORAL_API_KEY=production-temporal-cloud-key

# Security
APPROVAL_SIGNING_KEY=<64 hex chars — approval signing key>
# Encrypts TOTP factors; BFF only. Preserve across restarts. To rotate, set a new
# value and move the old one to AXIOM_MFA_ENCRYPTION_KEYS_PREVIOUS below.
AXIOM_MFA_ENCRYPTION_KEY=<64 hex chars — distinct MFA encryption key>
# Keys being retired, comma separated, newest first. Empty unless a rotation is
# in progress. A factor sealed under one of these still verifies and is rewritten
# under AXIOM_MFA_ENCRYPTION_KEY the next time its owner authenticates, so a
# rotation finishes at the pace people log in. Remove a key here only once
# nothing is sealed under it — early removal locks those users out.
AXIOM_MFA_ENCRYPTION_KEYS_PREVIOUS=
AXIOM_MFA_SESSION_TTL_HOURS=12
# Proxies in front of the BFF. 0 disables address-scoped MFA budgets,
# which is correct when nothing rewrites x-forwarded-for.
AXIOM_TRUSTED_PROXY_HOPS=0
AGENT_RUNTIME_INTERNAL_TOKEN=<48 hex chars — internal runtime token>
MODEL_GATEWAY_API_KEY=<48 hex chars — model gateway key>
BFF_CORS_ORIGINS=https://axiomproof.ai,https://app.axiomproof.ai

# Sovereign Data Residency & Evidence Vault Storage
AXIOM_REGION=ap-south-1
AXIOM_EVIDENCE_BUCKET=axiom-proof-evidence-prod
AXIOM_STORAGE_ENDPOINT=
AXIOM_STORAGE_ACCESS_KEY_ID=production-s3-access-key-placeholder
AXIOM_STORAGE_SECRET_ACCESS_KEY=production-s3-secret-key-placeholder
AWS_REGION=ap-south-1

# Redis / Upstash Cache
UPSTASH_REDIS_URL=rediss://default:placeholder@production-redis.upstash.io:6379
REDIS_URL=rediss://default:placeholder@production-redis.upstash.io:6379

# Multi-Model LLM Gateway Hierarchy (Anthropic -> OpenAI -> Gemini)
ANTHROPIC_API_KEY=sk-ant-production-key-placeholder
OPENAI_API_KEY=sk-proj-production-key-placeholder
GEMINI_API_KEY=AQ.Ab8RN-production-key-placeholder
GOOGLE_API_KEY=AQ.Ab8RN-production-key-placeholder

# Transactional Email Delivery (Resend)
RESEND_API_KEY=re_production_resend_api_key_placeholder
AXIOM_FROM_EMAIL=Axiom Proof <platform@axiomproof.ai>
RESEND_FROM_EMAIL=Axiom Proof <platform@axiomproof.ai>
AXIOM_SALES_EMAIL=sales@axiomproof.ai
AXIOM_FOUNDER_EMAIL=founder@axiomminds.ai
CONTACT_RECIPIENT_EMAIL=hello@axiomminds.ai
CONTACT_FALLBACK_RECIPIENT_EMAIL=hello@axiomminds.ai

# Feature Flags
FEATURE_DRY_RUN_ENGINE=true
FEATURE_EXECUTION_ENGINE=true
FEATURE_LIVE_CONNECTORS=true
FEATURE_KILL_SWITCH=true
PII_REDACTION_ENABLED=true
AXIOM_E2E_BYPASS_AUTH=false

# Auth Secrets
PGRGOTRUE_JWT_SECRET=production-gotrue-jwt-secret-placeholder
PGRST_JWT_SECRET=production-postgrest-jwt-secret-placeholder

# ─── Evidence retention (irreversible once applied) ──────────────────────────
# Days of COMPLIANCE-mode Object Lock on the evidence bucket. Compliance mode
# cannot be shortened or overridden by anyone, including the project owner, so
# this is a one-way door for every object written under it.
#
# The DPDPA statutory retention Axiom Proof reports against is 2555 days
# (seven years). Pre-production deliberately uses a short value so a test
# bucket does not become undeletable for seven years. Set this consciously per
# environment; it had no key at all until W0.1 and silently took Terraform's
# default of 7 everywhere, including anywhere that claimed the statutory term.
AXIOM_EVIDENCE_RETENTION_DAYS=2555

# ─── Production cluster topology (AWS EKS) ───────────────────────────────────
# These are declared by infra/terraform/envs/prod/variables.tf. They had
# Terraform defaults and no environment key, so the .env could not change them.
AXIOM_CLUSTER_NAME=axiom-proof-prod
AXIOM_VPC_CIDR=10.10.0.0/16
AXIOM_KUBERNETES_VERSION=1.29
AXIOM_DOMAIN_NAME=axiomproof.ai


# Optional exact source revision; BFF health reports it for deployed acceptance.
# AXIOM_RELEASE_SHA=<40-character-git-sha>

# BFF report mail: explicitly opt in only after provider/domain verification.
AXIOM_REPORT_EMAIL_MODE=disabled
# Founder-contact notification mail on the BFF (C-W0-6); inquiries persist regardless.
AXIOM_CONTACT_EMAIL_MODE=disabled

# Private dispatch inputs/proofs after independent completion; separate from evidence retention.
AXIOM_ASSESSMENT_DISPATCH_RETENTION_DAYS=90
