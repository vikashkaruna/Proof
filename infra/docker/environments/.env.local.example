# Axiom Proof — Local Development Environment (.env.local)
ENVIRONMENT=development
NODE_ENV=development
LOG_LEVEL=info

# Service Ports (Host bindings)
MARKETING_PORT=3000
WEB_PORT=3001
BFF_PORT=4000
AGENT_RUNTIME_PORT=8000
MODEL_GATEWAY_PORT=8001
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233

# Supabase Local (running on host or container)
SUPABASE_URL=http://host.docker.internal:55321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
SUPABASE_DB_URL=postgresql://postgres:postgres@host.docker.internal:55322/postgres

# Next.js Public
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
NEXT_PUBLIC_BFF_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000

# Inter-service URLs (within Docker Network)
AGENT_RUNTIME_URL=http://agent-runtime:8000
MODEL_GATEWAY_URL=http://model-gateway:8001
BFF_URL=http://bff:4000
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=axiom-proof
TEMPORAL_TLS=false

# Security & Tokens (Dev defaults)
APPROVAL_SIGNING_KEY=dev-signing-secret-key-at-least-32-chars-long-12345
# Encrypts TOTP factors; BFF only. Preserve across restarts. To rotate, set a new
# value and move the old one to AXIOM_MFA_ENCRYPTION_KEYS_PREVIOUS below.
AXIOM_MFA_ENCRYPTION_KEY=dev-mfa-encryption-key-local-only-32-characters
# Keys being retired, comma separated, newest first. Empty unless a rotation is
# in progress. A factor sealed under one of these still verifies and is rewritten
# under AXIOM_MFA_ENCRYPTION_KEY the next time its owner authenticates, so a
# rotation finishes at the pace people log in. Remove a key here only once
# nothing is sealed under it — early removal locks those users out.
AXIOM_MFA_ENCRYPTION_KEYS_PREVIOUS=
AXIOM_MFA_SESSION_TTL_HOURS=12
# Proxies in front of the BFF. 0 disables address-scoped MFA budgets,
# which is correct when nothing rewrites x-forwarded-for.
AXIOM_TRUSTED_PROXY_HOPS=0
AGENT_RUNTIME_INTERNAL_TOKEN=dev-agent-runtime-token-axiom
MODEL_GATEWAY_API_KEY=dev-model-gateway-key-axiom
BFF_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Sovereign Data Residency & Evidence Vault Storage
AXIOM_REGION=ap-south-1
AXIOM_EVIDENCE_BUCKET=axiom-proof-evidence-local
AXIOM_STORAGE_ENDPOINT=
AXIOM_STORAGE_ACCESS_KEY_ID=test
AXIOM_STORAGE_SECRET_ACCESS_KEY=test
AWS_REGION=ap-south-1

# Redis Cache
UPSTASH_REDIS_URL=
REDIS_URL=redis://localhost:6379

# Multi-Model LLM Gateway Fallback Hierarchy
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Email Delivery (Resend)
RESEND_API_KEY=
AXIOM_FROM_EMAIL=Axiom Proof <platform@axiomproof.ai>
RESEND_FROM_EMAIL=Axiom Proof <platform@axiomproof.ai>
AXIOM_SALES_EMAIL=sales@axiomproof.ai
AXIOM_FOUNDER_EMAIL=founder@axiomminds.ai
CONTACT_RECIPIENT_EMAIL=hello@axiomminds.ai
CONTACT_FALLBACK_RECIPIENT_EMAIL=hello@axiomminds.ai

# Feature Flags
FEATURE_DRY_RUN_ENGINE=true
FEATURE_EXECUTION_ENGINE=true
FEATURE_LIVE_CONNECTORS=false
FEATURE_KILL_SWITCH=true
PII_REDACTION_ENABLED=true
AXIOM_E2E_BYPASS_AUTH=true


# Optional exact source revision; BFF health reports it for deployed acceptance.
# AXIOM_RELEASE_SHA=<40-character-git-sha>

# BFF report mail: explicitly opt in only after provider/domain verification.
AXIOM_REPORT_EMAIL_MODE=disabled
# Founder-contact notification mail on the BFF (C-W0-6); inquiries persist regardless.
AXIOM_CONTACT_EMAIL_MODE=disabled

# Private dispatch inputs/proofs after independent completion; separate from evidence retention.
AXIOM_ASSESSMENT_DISPATCH_RETENTION_DAYS=90
