# Copy to .env.onprem (mode 0600). Supply all required values before bootstrap.
# No development keys, demo identities, or automatic secret minting are accepted.
AXIOM_BIND_ADDRESS=127.0.0.1
# Supply reviewed, preloaded registry manifest digests for every service.
# Both PostgreSQL images are PostgreSQL 17, matching local Supabase and CI
# (supabase/postgres 17.6.1.x for the application database).
AXIOM_POSTGRES_IMAGE=
AXIOM_AUTH_IMAGE=
AXIOM_POSTGREST_IMAGE=
AXIOM_INGRESS_IMAGE=
AXIOM_TEMPORAL_POSTGRES_IMAGE=
AXIOM_TEMPORAL_IMAGE=
AXIOM_REDIS_IMAGE=
AXIOM_MODEL_GATEWAY_IMAGE=
AXIOM_AGENT_RUNTIME_IMAGE=
AXIOM_BFF_IMAGE=
AXIOM_WORKER_IMAGE=
AXIOM_WEB_IMAGE=
SUPABASE_API_PORT=55321
BFF_PORT=4000
WEB_PORT=3001
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3001
NEXT_PUBLIC_BFF_URL=http://127.0.0.1:4000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
BFF_CORS_ORIGINS=http://127.0.0.1:3001
# Output from node scripts/mint-supabase-keys.mjs --env onprem:
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# BFF-only JWTs, each signed for its own database role (mint-supabase-keys.mjs):
SUPABASE_STATUTORY_PROOF_WRITER_KEY=
SUPABASE_ARCHIVE_WRITER_KEY=
SUPABASE_HUMAN_ACTION_WRITER_KEY=
SUPABASE_EVIDENCE_INGESTION_WRITER_KEY=
# Held by the BFF and agent-runtime only:
SUPABASE_AGENT_LEDGER_WRITER_KEY=
# Distinct random secrets; protect backups along with this file:
POSTGRES_PASSWORD=
POSTGREST_DB_PASSWORD=
TEMPORAL_DB_PASSWORD=
APPROVAL_SIGNING_KEY=
AXIOM_MFA_ENCRYPTION_KEY=
AGENT_RUNTIME_INTERNAL_TOKEN=
# Optional BFF/runtime-only source composer key. Mint an independent >=32-byte
# secret; never reuse the peer token or inject into other services. Empty
# disables source-bound Sudhaar proposals without affecting other modules.
AXIOM_PLANNING_SOURCE_SIGNING_KEY=
MODEL_GATEWAY_API_KEY=
AXIOM_STORAGE_ACCESS_KEY_ID=
AXIOM_STORAGE_SECRET_ACCESS_KEY=
AXIOM_MFA_ENCRYPTION_KEYS_PREVIOUS=
AXIOM_MFA_SESSION_TTL_HOURS=12
AXIOM_TRUSTED_PROXY_HOPS=0
AXIOM_EVIDENCE_BUCKET=axiom-proof-evidence-onprem
# Approved S3 Object Lock server/client images, preloaded by immutable digest.
AXIOM_WORM_SERVER_IMAGE=
AXIOM_WORM_CLIENT_IMAGE=
# Signed offline token and Ed25519 public key used by scripts/verify-license.ts.
AXIOM_OFFLINE_LICENSE=
# Empty means explicit 503 local_model_unavailable. To enable, add a real local-model
# service on the sovereign network and set http://local-model:<port>.
SELF_HOSTED_BASE_URL=
SELF_HOSTED_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ

# Optional assessment producer mapping in a protected file (mode 0600); unset refuses new requests.
# Mount it read-only and provision tenant/workload/key policy and wrap-only IAM separately.
# The BFF wraps/enqueues; controller claim, decrypt and confirmation remain separate.
# AXIOM_ASSESSMENT_PRODUCER_CONFIG_FILE=/run/secrets/assessment-producer.json

# Published URL; review for this environment before deployment.
AXIOM_PROOF_MARKETING_URL=http://localhost:3000

# Published URL; review for this environment before deployment.
AXIOM_PROOF_PLATFORM_URL=http://localhost:3001

# Marketing bootstrap: fixed role limits and private migration job settings.
MARKETING_AUTH_PASSWORD_SECRET=axiom-proof-onprem-auth-password
MARKETING_REST_PASSWORD_SECRET=axiom-proof-onprem-rest-password
GOTRUE_DB_MAX_POOL_SIZE=2
PGRST_DB_POOL=2
MARKETING_MIGRATION_CPU=1
MARKETING_MIGRATION_MEMORY=512Mi
MARKETING_MIGRATION_TIMEOUT_SECONDS=900

# Marketing lifecycle: private identities; Scheduler stays paused until acceptance.
MARKETING_LIFECYCLE_SERVICE_NAME=axiom-proof-onprem-lifecycle
MARKETING_LIFECYCLE_ACCOUNT_ID=axiom-proof-onprem-lifecycle
MARKETING_SCHEDULER_ACCOUNT_ID=axiom-proof-onprem-scheduler
MARKETING_LIFECYCLE_SCHEDULER_NAME=axiom-proof-onprem-idle-check
MARKETING_LIFECYCLE_SQL_ROLE_ID=axiom_proof_onprem_lifecycle_sql
MARKETING_LIFECYCLE_STATE_ROLE_ID=axiom_proof_onprem_lifecycle_state
MARKETING_LIFECYCLE_SCHEDULE=*/5 * * * *
MARKETING_LIFECYCLE_TIME_ZONE=Asia/Kolkata
MARKETING_LIFECYCLE_PAUSED=true
MARKETING_PYTHON_RUNTIME_IMAGE=<reviewed-python311-immutable-digest>
MARKETING_POSTGRES_CLIENT_IMAGE=<reviewed-python311-alpine324-immutable-digest>
AXIOM_MARKETING_TF_STATE_PREFIX=terraform/state/marketing-onprem
MARKETING_NODE_RUNTIME_IMAGE=<reviewed-node24-immutable-digest>
MARKETING_LIFECYCLE_CPU=1
MARKETING_LIFECYCLE_MEMORY=256Mi
MARKETING_LIFECYCLE_PORT=8080
MARKETING_LIFECYCLE_CONCURRENCY=8
MARKETING_MIGRATION_ACCOUNT_ID=axiom-proof-onprem-migrations

# Marketing-only reviewed Auth source and minimal PostgreSQL client build inputs.
# Review these together with exact final image security/rehearsal receipts.
# Official golang:1.27.2-bookworm multi-platform index; fixed October 2026 Go advisories.
MARKETING_AUTH_GO_BUILD_IMAGE=golang@sha256:5cf287a799e6b94384bad13d16b14904c531f51ba65792237e122ce42b392f61
MARKETING_AUTH_SOURCE_ARCHIVE_URL=https://codeload.github.com/supabase/auth/tar.gz/4eee58f296d9698a1c2c0ae14d7a0b379c7622d3
MARKETING_POSTGRES_CLIENT_APK_PACKAGE=postgresql17-client=17.11-r0
MARKETING_TRIVY_IMAGE=aquasec/trivy@sha256:af6acf9a6b85dfe389a1941505c0ce9efef52a4719635e1a962f022a3d855daa

# On-prem only: independently provisioned uncompromised Ed25519 public SPKI PEM.
# Store one line with literal \n escapes; never store the authority private key here.
AXIOM_LICENSE_ROOT_PUBLIC_KEY=
