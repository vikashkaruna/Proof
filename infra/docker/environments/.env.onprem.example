# ==============================================================================
# Axiom Proof — On-Premise Sovereign Configuration (.env.onprem)
# ==============================================================================
# Single-tenant / Sovereign on-premises intranet deployment
# Operates fully offline/intranet with local containerized Supabase,
# local model gateway, and local Temporal orchestration.
#
# Replace HOST_IP with your intranet IP address or server hostname
# ==============================================================================

ENVIRONMENT=onprem
NODE_ENV=production
LOG_LEVEL=info

# Host IP or Intranet Domain for Sovereign Deployment
HOST_IP=localhost

# Docker Registry Prefix (leave empty for local builds or specify private registry)
DOCKER_REGISTRY=
IMAGE_TAG=latest

# Service Ports
MARKETING_PORT=3000
WEB_PORT=3001
BFF_PORT=4000
AGENT_RUNTIME_PORT=8000
MODEL_GATEWAY_PORT=8001
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
SUPABASE_API_PORT=55321
SUPABASE_DB_PORT=55322
SUPABASE_STUDIO_PORT=55323

# Standalone Containerized Supabase Configuration
SUPABASE_URL=http://host.docker.internal:55321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
SUPABASE_DB_URL=postgresql://postgres:postgres@host.docker.internal:55322/postgres

# Browser-facing Client URLs
NEXT_PUBLIC_SUPABASE_URL=http://localhost:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
NEXT_PUBLIC_BFF_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000

# Inter-Service Internal Network URLs
AGENT_RUNTIME_URL=http://agent-runtime:8000
MODEL_GATEWAY_URL=http://model-gateway:8001
BFF_URL=http://bff:4000
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=axiom-proof
TEMPORAL_TLS=false
TEMPORAL_API_KEY=

# Security & Tokens
APPROVAL_SIGNING_KEY=<64 hex chars — approval signing key>
# Encrypts TOTP factors; BFF only. Preserve across restarts; rotate by re-encryption.
AXIOM_MFA_ENCRYPTION_KEY=<64 hex chars — distinct MFA encryption key>
AXIOM_MFA_SESSION_TTL_HOURS=12
# Proxies in front of the BFF. 0 disables address-scoped MFA budgets,
# which is correct when nothing rewrites x-forwarded-for.
AXIOM_TRUSTED_PROXY_HOPS=0
AGENT_RUNTIME_INTERNAL_TOKEN=<48 hex chars — internal runtime token>
MODEL_GATEWAY_API_KEY=<48 hex chars — model gateway key>
BFF_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Evidence Vault (Sovereign Storage / S3-compatible or MinIO)
AXIOM_REGION=ap-south-1
AXIOM_EVIDENCE_BUCKET=axiom-proof-evidence-onprem
AXIOM_STORAGE_ENDPOINT=
AXIOM_STORAGE_ACCESS_KEY_ID=mock
AXIOM_STORAGE_SECRET_ACCESS_KEY=mock
AWS_REGION=ap-south-1

# Redis Cache (Optional for On-Premise)
UPSTASH_REDIS_URL=
REDIS_URL=

# Model Gateway LLM Providers (Optional for Airgapped / Simulated Mode)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Transactional Email (Resend or Local SMTP Relay)
RESEND_API_KEY=
AXIOM_FROM_EMAIL=Axiom Proof <platform@axiomproof.ai>
RESEND_FROM_EMAIL=Axiom Proof <platform@axiomproof.ai>
AXIOM_SALES_EMAIL=sales@axiomproof.ai
AXIOM_FOUNDER_EMAIL=founder@axiomminds.ai
CONTACT_RECIPIENT_EMAIL=admin@axiomproof.local
CONTACT_FALLBACK_RECIPIENT_EMAIL=admin@axiomproof.local

# Feature Flags
FEATURE_DRY_RUN_ENGINE=true
FEATURE_EXECUTION_ENGINE=true
FEATURE_LIVE_CONNECTORS=true
FEATURE_KILL_SWITCH=true
PII_REDACTION_ENABLED=true
AXIOM_E2E_BYPASS_AUTH=false
