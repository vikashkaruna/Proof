MARKETING_LIFECYCLE_STATE_ROLE_ID=axiom_proof_preprod_lifecycle_state
MARKETING_LIFECYCLE_SCHEDULE=*/5 * * * *
MARKETING_LIFECYCLE_TIME_ZONE=Asia/Kolkata
MARKETING_LIFECYCLE_PAUSED=true
MARKETING_PYTHON_RUNTIME_IMAGE=python@sha256:d9368b3a5ac59afea7b5d4f2e2aea0941dbf9fdee9c369c5bec00b98244bc929
MARKETING_POSTGRES_CLIENT_IMAGE=python@sha256:d9368b3a5ac59afea7b5d4f2e2aea0941dbf9fdee9c369c5bec00b98244bc929
AXIOM_MARKETING_TF_STATE_PREFIX=terraform/state/marketing-preprod
MARKETING_NODE_RUNTIME_IMAGE=<reviewed-node24-immutable-digest>
MARKETING_LIFECYCLE_CPU=1
MARKETING_LIFECYCLE_MEMORY=256Mi
MARKETING_LIFECYCLE_PORT=8080
MARKETING_LIFECYCLE_CONCURRENCY=8
MARKETING_MIGRATION_ACCOUNT_ID=axiom-proof-preprod-migrations

# Marketing-only reviewed Auth source and minimal PostgreSQL client build inputs.
# Review these together with exact final image security/rehearsal receipts.
MARKETING_AUTH_GO_BUILD_IMAGE=golang@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414
MARKETING_AUTH_SOURCE_ARCHIVE_URL=https://codeload.github.com/supabase/auth/tar.gz/4eee58f296d9698a1c2c0ae14d7a0b379c7622d3
MARKETING_POSTGRES_CLIENT_APK_PACKAGE=postgresql16-client=16.15-r0
