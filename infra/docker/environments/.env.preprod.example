# ==============================================================================
# Axiom Proof — GCP Preprod Environment Configuration (.env.preprod) — TEMPLATE
# Region: Mumbai (asia-south1) · Sovereign Indian Data Residency
# ==============================================================================
# This file is for LOCAL DOCKER PARITY TESTING only — i.e. running the same
# stack on a workstation via:
#   docker compose -f docker-compose.yml -f infra/docker/docker-compose.preprod.yml \
#     --env-file infra/docker/environments/.env.preprod up -d
#
# The Cloud Run production preprod stack does NOT consume this file. Cloud Run
# services get their env from Secret Manager + literal env blocks defined in
# infra/terraform/envs/preprod/cloudrun.tf.
#
# Replace every <…> placeholder with the value provisioned in the matching
# step of docs/GCP_PREPROD_ENV_CONFIG_CHECKLIST.md. DO NOT COMMIT secrets.
# ==============================================================================

ENVIRONMENT=preprod
NODE_ENV=production
LOG_LEVEL=info

# ─── Service Ports (Cloud Run auto-binds $PORT; these are for local compose) ─
MARKETING_PORT=3000
WEB_PORT=3001
BFF_PORT=4000
AGENT_RUNTIME_PORT=8000
MODEL_GATEWAY_PORT=8001
PORT=8080

# ─── Sovereign Cloud Infrastructure (Mumbai asia-south1) ──────────────────────
AXIOM_PROJECT_ID=axiom-proof
AXIOM_PROJECT_NUMBER=188516662106
AXIOM_REGION=asia-south1
GCP_PROJECT_ID=axiom-proof
GCP_PROJECT_NUMBER=188516662106
GCP_REGION=asia-south1
AWS_REGION=asia-south1

# ─── Cloud SQL for PostgreSQL (asia-south1) ──────────────────────────────────
# Local: hit Cloud SQL over public IP with TLS.
# Cloud Run: use the Unix socket /cloudsql/<PROJECT>:<REGION>:<INSTANCE> instead.
SUPABASE_DB_URL=postgresql://axiom_admin:<DB_PASSWORD>@34.93.127.93:5432/axiom_proof_preprod

# ─── Supabase (Managed project — NOT local Kong) ─────────────────────────────
# Get these from Supabase Dashboard → Settings → API on your managed project.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-jwt>
SUPABASE_SERVICE_KEY=<service-role-jwt>

# ─── Upstash Serverless Redis ────────────────────────────────────────────────
# Provisioned in Step 2.1 of the checklist.
UPSTASH_REDIS_URL=rediss://default:<token>@<host>.upstash.io:6379
REDIS_URL=rediss://default:<token>@<host>.upstash.io:6379

# ─── Temporal Cloud GCP Subscription ─────────────────────────────────────────
# Provisioned in Step 2.2 of the checklist.
TEMPORAL_ADDRESS=axiom-proof.tmprl.cloud:7233
TEMPORAL_NAMESPACE=axiom-proof.preprod
TEMPORAL_TLS=true
TEMPORAL_API_KEY=<temporal-api-key>

# ─── Multi-Model Fallback Chain (Anthropic -> OpenAI -> Gemini) ───────────────
# Provisioned in Step 2.3 of the checklist. Must come from accounts with a
# no-training / no-retention DPA executed (Hard Rule 5).
ANTHROPIC_API_KEY=sk-ant-api03-<…>
OPENAI_API_KEY=sk-proj-<…>
GEMINI_API_KEY=AIza<…>
GOOGLE_API_KEY=AIza<…>

# ─── Sovereign Evidence Vault (WORM Compliance Storage) ──────────────────────
# Bucket name + HMAC credentials come from `terraform output`.
AXIOM_EVIDENCE_BUCKET=axiom-proof-evidence-preprod-<suffix>
AXIOM_STORAGE_ENDPOINT=https://storage.googleapis.com
AXIOM_STORAGE_ACCESS_KEY_ID=<HMAC access ID — terraform output gcs_hmac_access_id>
AXIOM_STORAGE_SECRET_ACCESS_KEY=<HMAC secret — terraform output -raw gcs_hmac_secret>

# ─── Cloud Run Service URLs (asia-south1) ────────────────────────────────────
# Standard deterministic Cloud Run URL scheme: https://<service>-<project_number>.<region>.run.app
# e.g., using GCP_PROJECT_NUMBER=188516662106 and GCP_REGION=asia-south1:
BFF_URL=https://axiom-bff-preprod-188516662106.asia-south1.run.app
NEXT_PUBLIC_BFF_URL=https://axiom-bff-preprod-188516662106.asia-south1.run.app
NEXT_PUBLIC_APP_URL=https://axiom-web-preprod-188516662106.asia-south1.run.app
NEXT_PUBLIC_MARKETING_URL=https://axiom-marketing-preprod-188516662106.asia-south1.run.app
AGENT_RUNTIME_URL=https://axiom-agent-runtime-preprod-188516662106.asia-south1.run.app
MODEL_GATEWAY_URL=https://axiom-model-gateway-preprod-188516662106.asia-south1.run.app

# ─── Sovereign Security & Signing Keys ───────────────────────────────────────
# Generated in Step 2.4 of the checklist (openssl rand -hex 32 / 24).
APPROVAL_SIGNING_KEY=<64 hex chars — approval token HMAC>
AGENT_RUNTIME_INTERNAL_TOKEN=<48 hex chars — BFF→agent-runtime internal token>
MODEL_GATEWAY_API_KEY=<48 hex chars — agent-runtime→model-gateway key>

# ─── CORS (browser origins the BFF will accept) ──────────────────────────────
BFF_CORS_ORIGINS=https://axiom-web-preprod-188516662106.asia-south1.run.app,https://axiom-marketing-preprod-188516662106.asia-south1.run.app,http://localhost:3000,http://localhost:3001

# ─── Resend (transactional email — contact form, gap-scan report + magic-link) ──
RESEND_API_KEY=re_<…>
AXIOM_FROM_EMAIL=Axiom Proof <platform@axiomproof.ai>
RESEND_FROM_EMAIL=Axiom Proof <platform@axiomproof.ai>
AXIOM_SALES_EMAIL=sales@axiomproof.ai
AXIOM_FOUNDER_EMAIL=founder@axiomminds.ai
CONTACT_RECIPIENT_EMAIL=hello@axiomminds.ai
CONTACT_FALLBACK_RECIPIENT_EMAIL=hello@axiomminds.ai

# ─── Statutory Feature Flags ─────────────────────────────────────────────────
FEATURE_DRY_RUN_ENGINE=true
FEATURE_EXECUTION_ENGINE=true
FEATURE_LIVE_CONNECTORS=true
FEATURE_KILL_SWITCH=true
PII_REDACTION_ENABLED=true

# ─── E2E (set to 'true' ONLY in test, never preprod) ─────────────────────────
AXIOM_E2E_BYPASS_AUTH=false

# ─── Auth Secrets ────────────────────────────────────────────────────────────
PGRGOTRUE_JWT_SECRET=<placeholder-gotrue-jwt-secret>
PGRST_JWT_SECRET=<placeholder-postgrest-jwt-secret>

