# ==============================================================================
# Axiom Proof — GCP Preprod Terraform Variables Example
# ==============================================================================

project_id             = "axiom-proof"
region                 = "asia-south1" # Strictly Mumbai
environment            = "preprod"
cloud_sql_tier         = "db-custom-2-7680" # Or db-f1-micro for cost-optimized preprod
cloud_sql_disk_size_gb = 20

# Upstash Redis
upstash_redis_url = "rediss://default:YOUR_UPSTASH_TOKEN@your-upstash-instance.upstash.io:6379"

# Temporal Cloud GCP Subscription
temporal_address   = "axiom-proof.tmprl.cloud:7233"
temporal_namespace = "axiom-proof"
temporal_api_key   = "your-temporal-cloud-api-key"

# Agent Models Fallback Hierarchy (Anthropic -> OpenAI -> Gemini)
anthropic_api_key = "sk-ant-api03-..."
openai_api_key    = "sk-proj-..."
gemini_api_key    = "AIzaSy..."

# Security Tokens — leave blank for stable generated keys, or supply secret-manager values.
approval_signing_key         = ""
agent_runtime_internal_token = ""
model_gateway_api_key        = ""

mfa_encryption_key           = ""
# Empty unless an MFA key rotation is in flight. Comma-separated, newest first.
mfa_encryption_keys_previous = ""

# Transactional Email (Resend)
resend_api_key          = "re_your_resend_api_key_here"
axiom_from_email        = "Axiom Proof <platform@axiomproof.ai>"
axiom_sales_email       = "sales@axiomproof.ai"
axiom_founder_email     = "founder@axiomminds.ai"
contact_recipient_email = "hello@axiomminds.ai"

report_email_mode = "disabled"
