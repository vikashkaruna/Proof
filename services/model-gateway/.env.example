# Axiom Proof — Model Gateway environment configuration
ENVIRONMENT=development
LOG_LEVEL=info
HTTP_HOST=0.0.0.0
HTTP_PORT=8001

# AWS Bedrock
AWS_REGION=ap-south-1

# Redis Cache (optional in dev; falls back to in-memory)
CACHE_BACKEND=memory

# Optional exact source revision; BFF health reports it for deployed acceptance.
# AXIOM_RELEASE_SHA=<40-character-git-sha>

# On-prem only: independently provisioned uncompromised Ed25519 public SPKI PEM.
# Store one line with literal \n escapes; never store the authority private key here.
AXIOM_LICENSE_ROOT_PUBLIC_KEY=
