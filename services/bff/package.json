{
  "name": "@axiom/bff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "echo 'no lint config'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "echo 'BFF has no Playwright suite; see apps/web/tests/e2e'",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@axiom/approval-engine": "workspace:*",
    "@axiom/config": "workspace:*",
    "@axiom/control-library": "workspace:*",
    "@axiom/evidence": "workspace:*",
    "@axiom/ledger": "workspace:*",
    "@axiom/supabase": "workspace:*",
    "@axiom/types": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "@supabase/supabase-js": "^2.116.0",
    "hono": "^4.13.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
