{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*", "tsconfig.base.json"],
  "globalEnv": [
    "NODE_ENV",
    "SUPABASE_URL",
    "SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_KEY",
    "AXIOM_REGION",
    "AXIOM_EVIDENCE_BUCKET",
    "AXIOM_STORAGE_ENDPOINT",
    "AXIOM_STORAGE_ACCESS_KEY_ID",
    "AXIOM_STORAGE_SECRET_ACCESS_KEY",
    "AXIOM_PROJECT_ID",
    "AWS_REGION",
    "TEMPORAL_ADDRESS",
    "TEMPORAL_NAMESPACE",
    "MODEL_GATEWAY_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"],
      "inputs": [
        "src/**",
        "public/**",
        "next.config.*",
        "tsconfig.json",
        "package.json",
        "tailwind.config.*",
        "postcss.config.*"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": ["src/**", "tests/**", "vitest.config.*"]
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": ["build"],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "clean": {
      "cache": false,
      "outputs": []
    },
    "@axiom/types#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": [
        "src/**",
        "tests/**",
        "vitest.config.*",
        "$TURBO_ROOT$/infra/supabase/migrations/*.sql"
      ]
    }
  }
}
